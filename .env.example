# Backend URL. Leave empty for local dev (Vite proxies /api to http://127.0.0.1:8000).
# On Vercel: https://<your-backend>.onrender.com   ("/api" is added automatically)
VITE_API_BASE_URL=

# Google Maps key (Places autocomplete + Routes). Leave empty to type kilometres by hand.
VITE_GOOGLE_MAPS_KEY=
